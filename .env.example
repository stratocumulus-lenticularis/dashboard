# Copy to .env and fill in. .env is ignored by git - never commit real values.

# --- General ---
DASHBOARD_TIMEZONE=Europe/Berlin
# auto = Waveshare e-paper if driver is available, otherwise PNG preview
DISPLAY_DRIVER=auto
FULL_REFRESH_MINUTES=30
SLEEP_START=00:00
SLEEP_END=06:00
LOG_LEVEL=INFO

# --- MeteoSwiss (forecast) ---
# Swiss postcode: 4 digits (e.g. 8001) or MeteoSwiss 6 digits (800100)
PLZ=

# --- Netatmo (own station, current observations) ---
# App from https://dev.netatmo.com, scope read_station
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
# optional: station MAC if the account has several stations
NETATMO_DEVICE_ID=

# --- Solar Manager (PV and battery) ---
SOLARMANAGER_URL=
SOLARMANAGER_TOKEN=

# --- Family calendar (Google "secret address in iCal format") ---
GOOGLE_CALENDAR_ICS_URL=

# --- Arsenal fixtures (football-data.org, free token) ---
FOOTBALL_DATA_TOKEN=
ARSENAL_TEAM_ID=57

