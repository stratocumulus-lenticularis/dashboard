# Copy to .env and fill in. .env is ignored by git - never commit real values.

# --- General ---
DASHBOARD_TIMEZONE=Europe/Berlin
# auto = Waveshare e-paper if driver is available, otherwise PNG preview
DISPLAY_DRIVER=auto
FULL_REFRESH_MINUTES=30
SLEEP_START=00:00
SLEEP_END=06:00
LOG_LEVEL=INFO

# --- MeteoSwiss (forecast) ---
# Swiss postcode: 4 digits (e.g. 8001) or MeteoSwiss 6 digits (800100)
PLZ=

# --- Netatmo (own station, current observations) ---
# App from https://dev.netatmo.com, scope read_station
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
# optional: station MAC if the account has several stations
NETATMO_DEVICE_ID=
# optional: which OUTDOOR module to show - its name as in the Netatmo app
# (e.g. Outdoor) or its MAC address. Empty = first outdoor module.
NETATMO_MODULE=

# --- Solar Manager (PV and battery) ---
# Address of the Solar Manager API. Either the device on your LAN, e.g.
#   SOLARMANAGER_URL=192.168.1.50      (-> https://192.168.1.50/v2/point)
# or a full URL. Do NOT use the web app address (cloud.solar-manager.ch).
SOLARMANAGER_URL=
# API key, sent as "X-API-Key" header
SOLARMANAGER_TOKEN=
# The device on your LAN normally has a self-signed certificate. If --check
# reports "certificate not trusted", set this to 0 (only for a LAN address).
SOLARMANAGER_VERIFY_SSL=1

# --- Family calendar (Google "secret address in iCal format") ---
GOOGLE_CALENDAR_ICS_URL=

# --- Arsenal fixtures (football-data.org, free token) ---
FOOTBALL_DATA_TOKEN=
ARSENAL_TEAM_ID=57

